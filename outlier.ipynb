import numpy as np
import pandas as pd

# -------------------------------------------------
# 1. Load dataset
# -------------------------------------------------
input_path = r"C:\Users\hp5cd\OneDrive\Desktop\Data Collection for Roboss Paper\Sunspots_train.csv"
output_path = r"C:\Users\hp5cd\OneDrive\Desktop\Data Collection for Roboss Paper\Sunspots_train_outliers_30pct.csv"

df = pd.read_csv(input_path)

# Keep only numerical columns (important safety step)
X = df.select_dtypes(include=[np.number]).values

num_samples, num_features = X.shape

print(f"Dataset shape: {num_samples} samples, {num_features} features")

# -------------------------------------------------
# 2. Outlier parameters (same as MATLAB)
# -------------------------------------------------
outlier_percentage = 30       # 10% outliers
outlier_factor = 10              # multiply by 10
num_outliers = round((outlier_percentage / 100) * num_samples)

# -------------------------------------------------
# 3. Randomly select sample indices
# -------------------------------------------------
np.random.seed(42)  # reproducibility 
outlier_indices = np.random.choice(num_samples, num_outliers, replace=False)

# -------------------------------------------------
# 4. Inject feature outliers
# -------------------------------------------------
for idx in outlier_indices:
    feature_index = np.random.randint(0, num_features)  # random feature
    X[idx, feature_index] *= outlier_factor

# -------------------------------------------------
# 5. Save corrupted dataset
# -------------------------------------------------
df_out = df.copy()
df_out[df.select_dtypes(include=[np.number]).columns] = X

df_out.to_csv(output_path, index=False)

print(f"Outlier-injected dataset saved to:\n{output_path}")
